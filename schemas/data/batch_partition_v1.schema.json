{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlm.dev/schemas/data/batch_partition_v1.schema.json",
  "title": "TrainLM Packed Batch Partition Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "split",
    "seed",
    "epoch",
    "world_size",
    "rank",
    "cross_shard_remainder",
    "host_remainder",
    "dataset_fingerprint",
    "schedule_fingerprint",
    "shard_order",
    "dropped_token_count",
    "global_batch_count",
    "retained_batch_count",
    "dropped_batch_indices",
    "batch_indices"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "split": {"enum": ["train", "validation"]},
    "seed": {"type": "integer", "minimum": 0},
    "epoch": {"type": "integer", "minimum": 0},
    "world_size": {"type": "integer", "minimum": 1},
    "rank": {"type": "integer", "minimum": 0},
    "cross_shard_remainder": {"enum": ["drop", "error"]},
    "host_remainder": {"enum": ["drop", "error"]},
    "dataset_fingerprint": {"$ref": "#/$defs/sha256"},
    "schedule_fingerprint": {"$ref": "#/$defs/sha256"},
    "shard_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dropped_token_count": {"type": "integer", "minimum": 0},
    "global_batch_count": {"type": "integer", "minimum": 0},
    "retained_batch_count": {"type": "integer", "minimum": 0},
    "dropped_batch_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "batch_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"split": {"const": "validation"}}},
      "then": {
        "properties": {
          "seed": {"const": 0},
          "epoch": {"const": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
