{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlm.dev/schemas/data/packed_binary_shard_v1.schema.json",
  "title": "TrainLM Packed Binary Shard Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shard_id",
    "data_path",
    "compatibility_profile",
    "header_bytes",
    "token_dtype",
    "byte_order",
    "token_count",
    "token_id_min",
    "token_id_max",
    "vocab_size",
    "file_size_bytes",
    "sha256",
    "documents",
    "manifest_type"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "packed_binary_shard"},
    "shard_id": {"type": "string", "minLength": 1},
    "data_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "compatibility_profile": {
      "enum": ["explicit_v1", "legacy_1024_uint16"]
    },
    "header_bytes": {"type": "integer", "minimum": 0},
    "token_dtype": {"enum": ["uint16", "uint32", "int32", "int64"]},
    "byte_order": {"enum": ["little", "big"]},
    "token_count": {"type": "integer", "minimum": 1},
    "token_id_min": {"type": "integer", "minimum": 0},
    "token_id_max": {"type": "integer", "minimum": 0},
    "vocab_size": {"type": "integer", "minimum": 1},
    "file_size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {"$ref": "#/$defs/document_index"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "compatibility_profile": {"const": "legacy_1024_uint16"}
        }
      },
      "then": {
        "properties": {
          "header_bytes": {"const": 1024},
          "token_dtype": {"const": "uint16"},
          "byte_order": {"const": "little"}
        }
      }
    }
  ],
  "$defs": {
    "document_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "document_count", "path", "sha256", "size_bytes"],
      "properties": {
        "storage": {"enum": ["unavailable", "uint64_offsets"]},
        "document_count": {"type": ["integer", "null"], "minimum": 1},
        "path": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"storage": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "document_count": {"const": null},
              "path": {"const": null},
              "sha256": {"const": null},
              "size_bytes": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"storage": {"const": "uint64_offsets"}}},
          "then": {
            "properties": {
              "document_count": {"type": "integer", "minimum": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 16}
            }
          }
        }
      ]
    }
  }
}
