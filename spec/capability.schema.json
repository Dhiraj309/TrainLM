{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIPM Capability Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "tools",
    "entrypoint"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$",
      "description": "Unique capability name (lowercase, kebab or snake case)"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][a-zA-Z0-9\\.]+)?$",
      "description": "Semver version string"
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-]+$"
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema for tool input"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean",
          "default": false
        },
        "filesystem": {
          "type": "boolean",
          "default": false
        },
        "subprocess": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of capability dependencies (name@version)"
    },
    "entrypoint": {
      "type": "string",
      "description": "Relative path to the capability's Python entry file"
    }
  }
}
