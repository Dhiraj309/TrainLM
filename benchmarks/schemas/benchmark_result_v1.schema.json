{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlm.dev/schemas/benchmark_result_v1.schema.json",
  "title": "TrainLM Benchmark Result V1",
  "description": "One synchronized steady-state benchmark measurement window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workload_id",
    "workload_version",
    "framework",
    "framework_revision",
    "backend",
    "accelerator_type",
    "measurement_kind",
    "cache_state",
    "device_synchronized",
    "device_count",
    "host_count",
    "data_parallel_replicas",
    "warmup_steps",
    "measured_steps",
    "scheduled_tokens_per_update",
    "supervised_tokens_per_replica",
    "ignored_tokens_per_replica",
    "measurement_wall_seconds",
    "measurement_device_seconds",
    "total_step_seconds_median",
    "device_step_seconds_median",
    "compile_seconds",
    "peak_hbm_gib",
    "input_idle_fraction",
    "collective_seconds_median",
    "compile_count",
    "unexpected_compile_count",
    "cpu_fallback_count",
    "non_embedding_flops_per_token",
    "logits_inclusive_flops_per_token",
    "peak_flops_per_device",
    "global_tokens_per_second",
    "device_tokens_per_second",
    "non_embedding_mfu",
    "logits_inclusive_mfu",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "workload_id": {"type": "string", "minLength": 1},
    "workload_version": {"type": "integer", "minimum": 1},
    "framework": {"type": "string", "minLength": 1},
    "framework_revision": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "accelerator_type": {"type": "string", "minLength": 1},
    "measurement_kind": {
      "type": "string",
      "enum": ["compile", "steady_state", "stability"]
    },
    "cache_state": {
      "type": "string",
      "enum": ["cold", "warm", "unknown"]
    },
    "device_synchronized": {"const": true},
    "device_count": {"type": "integer", "minimum": 1},
    "host_count": {"type": "integer", "minimum": 1},
    "data_parallel_replicas": {"type": "integer", "minimum": 1},
    "warmup_steps": {"type": "integer", "minimum": 0},
    "measured_steps": {"type": "integer", "minimum": 1},
    "scheduled_tokens_per_update": {"type": "integer", "minimum": 1},
    "supervised_tokens_per_replica": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "ignored_tokens_per_replica": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "measurement_wall_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "measurement_device_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_step_seconds_median": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "device_step_seconds_median": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "compile_seconds": {"type": "number", "minimum": 0},
    "peak_hbm_gib": {"type": "number", "minimum": 0},
    "input_idle_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "collective_seconds_median": {"type": "number", "minimum": 0},
    "compile_count": {"type": "integer", "minimum": 0},
    "unexpected_compile_count": {"type": "integer", "minimum": 0},
    "cpu_fallback_count": {"type": "integer", "minimum": 0},
    "non_embedding_flops_per_token": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "logits_inclusive_flops_per_token": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "peak_flops_per_device": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "global_tokens_per_second": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "device_tokens_per_second": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "non_embedding_mfu": {"type": "number", "minimum": 0},
    "logits_inclusive_mfu": {"type": "number", "minimum": 0},
    "metadata": {"type": "object"}
  }
}
